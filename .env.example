# ---------------------------------------------------------------
# Cricket Quiz Arena - backend settings
# Copy this file to ".env" (same folder) and edit the values.
# Never share or upload your real .env file.
# ---------------------------------------------------------------

# Port for the backend server. The app opens at http://localhost:3000
PORT=3000

# OPTION 1 (default) - Local MongoDB Community Server (view it in MongoDB Compass)
MONGODB_URI=mongodb://127.0.0.1:27017/cricket_quiz_arena_oss

# OPTION 2 - MongoDB Atlas (cloud). Put a # in front of the line above, remove the # below,
# and paste your Atlas string. Keep "/cricket_quiz_arena_oss" after ".mongodb.net".
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.xxxxx.mongodb.net/cricket_quiz_arena_oss?retryWrites=true&w=majority

# Number of random questions in one quiz
QUESTIONS_PER_QUIZ=10
